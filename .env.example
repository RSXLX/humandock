# Default is the isolated local demo. Real-chain paths require every relevant gate.
APP_MODE=demo
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# If absent, the local demo uses embedded PostgreSQL at .data/pglite.
# DATABASE_URL=postgres://humandock:replace-locally@localhost:5432/humandock
# Verified TESTNET facts, 2026-11-18: EVM chain 400, bank umec exponent 8,
# one bank atom = 10^10 EVM wei. See docs/network-verification.md.
# The official SDK publishes HTTP EVM; no official HTTPS EVM was found in this review.
# Obtain an authorized HTTPS EVM endpoint. REST and Tendermint URLs are NOT EVM RPC.
ME_EVM_RPC_URL=
ME_PUBLIC_RPC_URL=
ME_EVM_CHAIN_ID=400
ME_QUANTUM_WEI=10000000000
ME_NETWORK=me-testnet
ME_NATIVE_SYMBOL=MEC
ME_BANK_DENOM=umec
ME_BANK_DECIMALS=8
ME_COSMOS_REST_URL=https://beta-hub-1317.explorer-testnet.me
ME_UNIT_VERIFICATION_FILE=packages/me/observations/testnet-units-verified.json
# Set an explicit application minimum and a source/policy reference. The numeric
# KYC enum is known; its equivalence to HARBOR participant "Advanced" is NOT proven.
ME_MIN_KYC_LEVEL=
ME_ID_POLICY_REFERENCE=
# Stable, random server-only HMAC secret. Back it up with the database; changing
# it blocks new admissions on existing orders until an explicit key migration.
ME_ID_HASH_SECRET=
ME_REVIEWER_WALLETS=
# Three purpose-specific attestation keys; never user spending keys. Never commit.
ME_QUOTE_SIGNER_KEY=
ME_ASSIGNMENT_SIGNER_KEY=
ME_DELIVERY_GATE_KEY=
# Contract amounts are integer EVM wei. Example bounded test quote = 0.0012 MEC.
ME_REVIEWER_FEE_WEI=1000000000000000
ME_PLATFORM_FEE_WEI=200000000000000
ME_GAS_ACCOUNTING=me-bank-ceil-prepay-floor-refund
# Manifest produced by the explicit deployment command, including code hashes,
# constructor roles, deployment start block and required confirmation depth.
ME_DEPLOYMENT_FILE=
ME_ENABLE_MAINNET=false
# Optional read-only unit probe (public system module or an authorized wallet):
ME_UNIT_PROBE_ADDRESS=
ME_UNIT_PROBE_BLOCK=
# Explicit deploy command only; the API never reads a deployer key or deploys.
ME_DEPLOYER_PRIVATE_KEY=
ME_OWNER_ADDRESS=
ME_QUOTE_SIGNER_ADDRESS=
ME_ASSIGNMENT_SIGNER_ADDRESS=
ME_DELIVERY_GATE_ADDRESS=
ME_ARBITRATOR_ADDRESS=
ME_PLATFORM_RECIPIENT_ADDRESS=
ME_MAX_TASK_FEE_WEI=
ME_CONFIRMATIONS=
# Optional provider. Without this, assistance is explicitly local rules.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
